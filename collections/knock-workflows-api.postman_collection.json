          "name": "Cancel workflow",
          "request": {
            "name": "Cancel workflow",
            "description": {
              "content": "When invoked for a workflow using a specific workflow key and cancellation key, will cancel any queued workflow runs associated with that key/cancellation key pair. Can optionally be provided one or more recipients to scope the request to.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v1",
                "workflows",
                ":key",
                "cancel"
